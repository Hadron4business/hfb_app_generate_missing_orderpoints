<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_stock_orderpoint_generator_form" model="ir.ui.view">
        <field name="name">stock.orderpoint.generator.form</field>
        <field name="model">stock.orderpoint.generator</field>
        <field name="arch" type="xml">
            <form string="Generate Missing Reordering Rules">
                <group>
                    <group>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="warehouse_id"/>
                        <field name="location_id"/>
                        <field name="category_id"/>
                    </group>
                    <group>
                        <field name="product_min_qty"/>
                        <field name="product_max_qty"/>
                        <field name="skip_mode"/>
                        <field name="product_count"/>
                    </group>
                </group>
                <footer>
                    <button string="Generate" name="action_generate" type="object"
                            class="btn-primary" data-hotkey="q"
                            invisible="not product_count"/>
                    <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_stock_orderpoint_generator" model="ir.actions.act_window">
        <field name="name">Generate Missing Reordering Rules</field>
        <field name="res_model">stock.orderpoint.generator</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_stock_orderpoint_generator"
              name="Generate Missing Reordering Rules"
              parent="stock.menu_stock_warehouse_mgmt"
              action="action_stock_orderpoint_generator"
              groups="stock.group_stock_manager"
              sequence="120"/>

</odoo>
